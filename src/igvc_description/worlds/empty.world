<?xml version="1.0"?>
<sdf version="1.6">
  <world name="default">
    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>
    <!-- GPS icin: IGVC sahasi (Oakland Universitesi), dunya cercevesi ENU -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>42.668</latitude_deg>
      <longitude_deg>-83.218</longitude_deg>
      <elevation>0</elevation>
      <!-- 180: Gazebo Classic hatasi telafisi. heading 0 iken GPS ENU ekseni dunya ekseninin
           180 deg donugu cikiyor (dunyada +x'e giden arac GPS'te batiya gidiyor). 180 ile GPS ENU =
           dunya ENU; IMU yaw'i etkilenmez. Olculerek dogrulandi (igvc_localization 1. asama).
           Bu sayede GPS/EKF kodu simulasyonda ve gercek aracta ayni (elle yaw_offset yok). -->
      <heading_deg>180</heading_deg>
    </spherical_coordinates>
    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
    </physics>
  </world>
</sdf>
