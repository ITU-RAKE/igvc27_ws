<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- ===================== SABITLER ===================== -->
    <xacro:property name="PI" value="3.14159265359"/>

    <!-- Govde (kesik piramit). Mesh (chassis.stl) bu degerlerden otomatik uretilir:
         build sirasinda ve launch basinda scripts/generate_chassis_mesh.py ile -->
    <xacro:property name="chassis_bottom_length" value="0.95"/>
    <xacro:property name="chassis_bottom_width"  value="0.65"/>
    <xacro:property name="chassis_top_length"    value="0.85"/>
    <xacro:property name="chassis_top_width"     value="0.60"/>
    <xacro:property name="chassis_height"        value="0.30"/>
    <xacro:property name="chassis_mass"          value="25.0"/>
    <xacro:property name="ground_clearance"      value="0.10"/>  <!-- taban ile zemin arasi -->

    <!-- Ceker tekerlekler -->
    <xacro:property name="wheel_radius"     value="0.10"/>
    <xacro:property name="wheel_width"      value="0.06"/>
    <xacro:property name="wheel_mass"       value="1.5"/>
    <xacro:property name="wheel_x_offset"   value="0.0"/>    <!-- govde merkezine gore -->
    <xacro:property name="wheel_gap"        value="0.01"/>   <!-- govdenin en genis dis yuzeyi ile tekerlek ic yuzeyi arasi -->
    <!-- Tekerlek merkezleri arasi: govdenin en genis yeri + her iki yanda bosluk + tekerlek genisligi -->
    <xacro:property name="wheel_separation"
                    value="${max(chassis_bottom_width, chassis_top_width) + 2*wheel_gap + wheel_width}"/>
    <xacro:property name="max_effort"       value="50.0"/>
    <xacro:property name="max_velocity"     value="20.0"/>
    <!-- Simulasyon motor modeli (gazebo_ros2_control velocity_pid): tork = kp * hiz hatasi, 1 kHz.
         kp: tekerlek ataleti kucuk (~0.0075 kg m^2); kp*dt/I > ~2 olunca ayrik PID salinir (kp 50
         kararsiz), kp 10 kararli ve takip iyi.
         ki = 0: integral, viraj sirasinda biriktirdigi torku sifir komutta da uygulamaya devam eder;
         arac kp/ki saniye boyunca yavasca donmeye devam ederdi. -->
    <xacro:property name="wheel_pid_kp"     value="10.0"/>   <!-- N m / (rad/s) -->
    <xacro:property name="wheel_pid_ki"     value="0.0"/>

    <!-- Caster tekerlekler -->
    <!-- Kure capi = ground_clearance: hem govde tabanina hem zemine deger -->
    <xacro:property name="caster_radius"   value="${ground_clearance/2}"/>
    <xacro:property name="caster_mass"     value="0.3"/>
    <xacro:property name="caster_x_offset" value="${chassis_bottom_length/2 - 0.08}"/>
    <!-- Caster suspansiyonu (dikey kayar eklem + yay). Sabit caster'larla ortadan cekisli arac
         rampa basinda iki caster ustunde kopru olur, cekis tekerlekleri havada kalir (high-centering).
         Yay en fazla k * travel ~ 210 N tasir -> agirligin cogu her zaman cekis tekerleklerinde. -->
    <xacro:property name="caster_spring_k"  value="3000.0"/>  <!-- N/m -->
    <xacro:property name="caster_damping"   value="150.0"/>   <!-- N s/m -->
    <xacro:property name="caster_travel"    value="0.07"/>    <!-- m, yukari (iceri) -->
    <xacro:property name="caster_droop"     value="0.02"/>    <!-- m, asagi (tepe gecislerinde) -->

    <!-- Kameralar (konumlar govde merkezine gore, yukseklik zeminden) -->
    <xacro:property name="camera_height"   value="1.00"/>   <!-- optik merkez, zeminden -->
    <xacro:property name="camera_x_offset" value="0.325"/>  <!-- on/arka kamera, merkezden -->
    <xacro:property name="camera_y_offset" value="0.20"/>   <!-- sol/sag kamera, merkezden -->
    <xacro:property name="camera_pitch"    value="${radians(43)}"/>  <!-- + = asagi bakar -->
    <xacro:property name="camera_roll"     value="0.0"/>
    <xacro:property name="camera_yaw"      value="0.0"/>    <!-- her kameranin kendi yonune eklenir -->
    <!-- FOV: Gazebo (pinhole, kare piksel) yalnizca yatay FOV alir; dikey FOV
         en-boy oranindan cikar: vfov = 2*atan(tan(hfov/2) * h / w).
         98x75 icin oran ~1.5 (3:2) gerekir -> yukseklik genislikten hesaplanir (640x427). -->
    <xacro:property name="camera_hfov"     value="${radians(98)}"/>  <!-- yatay FOV -->
    <xacro:property name="camera_vfov"     value="${radians(75)}"/>  <!-- dikey FOV -->
    <xacro:property name="camera_img_w"    value="640"/>  <!-- 1280'den dusuruldu: Gazebo kameralari 14 -> 28 Hz, kus bakisi 14 -> 22 Hz; seritte kayip ~%4 (uzak uclar incelir). Homografi icin intrinsics buradan hesaplanir. -->
    <xacro:property name="camera_img_h"
                    value="${int(round(camera_img_w*tan(camera_vfov/2)/tan(camera_hfov/2)))}"/>
    <xacro:property name="camera_rate"     value="30"/>
    <xacro:property name="camera_mass"     value="0.1"/>
    <!-- Kamera govdesi (collision/primitif gorsel kutusu): CAD kamerasinin arka plaka + govde + lens
         olculeri. Kutu optik merkezin ARKASINDA (lens ucu = optik merkez), kamera kendini gormez -->
    <xacro:property name="camera_body_x"   value="0.031"/>
    <xacro:property name="camera_body_y"   value="0.043"/>
    <xacro:property name="camera_body_z"   value="0.043"/>

    <!-- Kamera diregi (CAD / gercek arac ile ayni): govde tabanindan yukselen iki direk (y=0, x=+-mast_pole_x,
         govdenin icinden gecer) + tepede arti seklinde iki profil. Kameralar profil uclarina 43 deg'lik
         mentese braketiyle baglanir (braket/kelepceler yalnizca CAD gorselinde) -->
    <xacro:property name="mast_profile"    value="0.02"/>   <!-- 20x20 profil -->
    <xacro:property name="mast_pole_x"     value="0.125"/>  <!-- direkler y=0, x=+-bu (uzunluk ekseni) -->
    <xacro:property name="mast_bar_x_len"  value="0.56"/>   <!-- on-arka tepe profili boyu -->
    <xacro:property name="mast_bar_y_len"  value="0.275"/>  <!-- sol-sag tepe profili boyu -->
    <xacro:property name="mast_bar_gap"    value="0.003"/>  <!-- profil ust yuzeyi ile optik merkez arasi -->
    <xacro:property name="mast_mass"       value="0.8"/>
    <!-- Tepe profili ust yuzeyi, govde tabanina gore -->
    <xacro:property name="mast_bar_top"
                    value="${camera_height - mast_bar_gap - ground_clearance}"/>
    <!-- Govde tabanindan profil alt yuzeyine kadar direk boyu -->
    <xacro:property name="mast_pole_len"   value="${mast_bar_top - mast_profile}"/>

    <!-- 2D lidarlar: govde tavaninda, on diregin onunde / arka diregin arkasinda.
         On: RPLIDAR S3 (kare govde), arka: RPLIDAR A2M8 (silindir). Olcu/kutle Slamtec datasheet'leri,
         CAD mesh'leri (meshes_cad/lidar_s3.stl, lidar_a2m8.stl) ile ayni -->
    <xacro:property name="lidar_x_offset"     value="0.35"/>   <!-- merkezden (CAD ile ayni) -->
    <xacro:property name="lidar_scan_height"  value="0.02"/>   <!-- link (tarama merkezi) govde ustunden -->
    <xacro:property name="lidar_base_gap"     value="0.004"/>  <!-- lidar tabani govde ustunden (montaj plakasi) -->
    <xacro:property name="lidar_s3_size_x"    value="0.0598"/> <!-- on-arka -->
    <xacro:property name="lidar_s3_size_y"    value="0.0556"/>
    <xacro:property name="lidar_s3_height"    value="0.0413"/>
    <xacro:property name="lidar_s3_mass"      value="0.115"/>
    <xacro:property name="lidar_a2m8_radius"  value="0.038"/>
    <xacro:property name="lidar_a2m8_height"  value="0.041"/>
    <xacro:property name="lidar_a2m8_mass"    value="0.19"/>
    <!-- Asagidaki tarama ayarlari IKI lidar icin ortak (S3 degerleri) -->
    <xacro:property name="lidar_fov"       value="${radians(280)}"/>  <!-- kendi onunde +-140 deg -->
    <xacro:property name="lidar_min_range" value="0.12"/>
    <xacro:property name="lidar_max_range" value="6.0"/>
    <!-- RPLIDAR S3: 32 kHz ornekleme, tarama 10-20 Hz (10 Hz'de 0.1125 deg, 20 Hz'de 0.225 deg).
         Frekans artinca tur basina nokta azalir; nokta sayisi buna gore hesaplanir. -->
    <xacro:property name="lidar_sample_rate" value="32000"/>  <!-- Hz, donanim sabiti -->
    <xacro:property name="lidar_rate"        value="20"/>     <!-- Hz, S3 icin en fazla 20 -->
    <xacro:property name="lidar_samples"
                    value="${int(round(lidar_sample_rate / lidar_rate * lidar_fov / (2*PI))) + 1}"/>


    <!-- IMU (gercek aracta BNO085: mutlak yaw, REP-145 ENU). Govde icinde, konum govde merkezine gore -->
    <xacro:property name="imu_x_offset"     value="0.0"/>
    <xacro:property name="imu_y_offset"     value="0.0"/>
    <xacro:property name="imu_height"       value="${ground_clearance + 0.05}"/>  <!-- zeminden -->
    <xacro:property name="imu_rate"         value="100"/>    <!-- Hz -->
    <xacro:property name="imu_gyro_std"     value="0.002"/>  <!-- rad/s, beyaz gurultu -->
    <xacro:property name="imu_gyro_bias"    value="0.0005"/> <!-- rad/s, sabit sapma (std) -->
    <xacro:property name="imu_accel_std"    value="0.02"/>   <!-- m/s^2 -->

    <!-- GPS (gercek aracta RTK). Anten direk tepesinde, capraz profillerin ortasinda -->
    <xacro:property name="gps_x_offset"     value="0.0"/>    <!-- govde merkezine gore -->
    <xacro:property name="gps_y_offset"     value="0.0"/>
    <xacro:property name="gps_body"         value="0.06"/>   <!-- anten kutusu kenari (gorsel) -->
    <xacro:property name="gps_height"
                    value="${camera_height - mast_bar_gap + gps_body/4}"/>  <!-- kutu (yukseklik gps_body/2) profil ustune oturur -->
    <xacro:property name="gps_rate"         value="10"/>     <!-- Hz -->
    <xacro:property name="gps_h_std"        value="0.02"/>   <!-- m, yatay (RTK fix) -->
    <xacro:property name="gps_v_std"        value="0.05"/>   <!-- m, dikey -->
    <xacro:property name="gps_vel_std"      value="0.02"/>   <!-- m/s -->

    <!-- CAD gorsel mesh'leri (meshes_cad/, metre). Kaynak: stl_exports/ (tekerlekler meshlab ile
         ~1.9M -> 40k ucgene indirildi, orijin lastik merkezine tasindi).
         Yalnizca <visual>: collision primitif, inertial makrolardan -> fizik cad_visual'dan bagimsiz.
         CAD tekerlek yaricapi 0.074; gorsel wheel_radius'a radyal olcekle buyutulur (gorunen = fiziksel).
         CAD caster yuksekligi 0.10 (= ground_clearance); ground_clearance degisirse olceklenir. -->
    <!-- Arg burada: igvc_controller/controller.launch.py bu dosyayi tek basina isler -->
    <xacro:arg name="cad_visual" default="true"/>
    <xacro:property name="use_cad_visual"   value="$(arg cad_visual)"/>
    <xacro:property name="cad_mesh_dir"     value="package://igvc_description/meshes_cad"/>
    <xacro:property name="cad_wheel_radius" value="0.074"/>
    <xacro:property name="cad_wheel_scale"  value="${wheel_radius/cad_wheel_radius}"/>
    <xacro:property name="cad_caster_scale" value="${ground_clearance/0.10}"/>

    <!-- ===================== INERTIAL MAKROLARI ===================== -->
    <xacro:macro name="box_inertial" params="mass x y z *origin">
        <inertial>
            <xacro:insert_block name="origin"/>
            <mass value="${mass}"/>
            <inertia ixx="${mass*(y*y + z*z)/12}" ixy="0" ixz="0"
                     iyy="${mass*(x*x + z*z)/12}" iyz="0"
                     izz="${mass*(x*x + y*y)/12}"/>
        </inertial>
    </xacro:macro>

    <!-- Silindir ekseni yerel z -->
    <xacro:macro name="cylinder_inertial" params="mass radius length *origin">
        <inertial>
            <xacro:insert_block name="origin"/>
            <mass value="${mass}"/>
            <inertia ixx="${mass*(3*radius*radius + length*length)/12}" ixy="0" ixz="0"
                     iyy="${mass*(3*radius*radius + length*length)/12}" iyz="0"
                     izz="${mass*radius*radius/2}"/>
        </inertial>
    </xacro:macro>

    <xacro:macro name="sphere_inertial" params="mass radius *origin">
        <inertial>
            <xacro:insert_block name="origin"/>
            <mass value="${mass}"/>
            <inertia ixx="${2*mass*radius*radius/5}" ixy="0" ixz="0"
                     iyy="${2*mass*radius*radius/5}" iyz="0"
                     izz="${2*mass*radius*radius/5}"/>
        </inertial>
    </xacro:macro>

    <!-- ===================== PARCA MAKROLARI ===================== -->
    <!-- side: left / right, reflect: 1 (sol, +y) / -1 (sag, -y) -->
    <xacro:macro name="drive_wheel" params="side reflect">
        <link name="${side}_wheel">
            <xacro:if value="${use_cad_visual}">
                <!-- Mesh aksi y (eklem ekseni); motor/reduktor iceri (govdeye) dogru uzanir -->
                <visual>
                    <origin xyz="0 0 0" rpy="0 0 0"/>
                    <geometry>
                        <mesh filename="${cad_mesh_dir}/${side}_wheel.stl"
                              scale="${cad_wheel_scale} 1 ${cad_wheel_scale}"/>
                    </geometry>
                    <material name="black"/>
                </visual>
            </xacro:if>
            <xacro:unless value="${use_cad_visual}">
                <visual>
                    <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
                    <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
                    <material name="black"/>
                </visual>
            </xacro:unless>
            <collision>
                <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
                <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
            </collision>
            <xacro:cylinder_inertial mass="${wheel_mass}" radius="${wheel_radius}" length="${wheel_width}">
                <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
            </xacro:cylinder_inertial>
        </link>

        <joint name="${side}_wheel_joint" type="continuous">
            <parent link="base_link"/>
            <child link="${side}_wheel"/>
            <!-- base_link zaten aks merkezi: tekerlek x=0 (wheel_x_offset govdeyi kaydirir) -->
            <origin xyz="0 ${reflect*wheel_separation/2} 0" rpy="0 0 0"/>
            <axis xyz="0 1 0"/>
            <limit effort="${max_effort}" velocity="${max_velocity}"/>
            <dynamics damping="0.1" friction="0.1"/>
        </joint>
    </xacro:macro>

    <!-- position: front / rear, reflect: 1 (on) / -1 (arka) -->
    <xacro:macro name="caster_wheel" params="position reflect">
        <link name="${position}_caster">
            <visual>
                <geometry>
                    <xacro:if value="${use_cad_visual}">
                        <!-- Doner caster (catal + teker); collision yine kure -->
                        <mesh filename="${cad_mesh_dir}/caster.stl"
                              scale="${cad_caster_scale} ${cad_caster_scale} ${cad_caster_scale}"/>
                    </xacro:if>
                    <xacro:unless value="${use_cad_visual}">
                        <sphere radius="${caster_radius}"/>
                    </xacro:unless>
                </geometry>
                <material name="grey"/>
            </visual>
            <collision>
                <geometry><sphere radius="${caster_radius}"/></geometry>
            </collision>
            <xacro:sphere_inertial mass="${caster_mass}" radius="${caster_radius}">
                <origin xyz="0 0 0" rpy="0 0 0"/>
            </xacro:sphere_inertial>
        </link>

        <!-- base_link tekerlek aksi yuksekliginde; caster zemine degecek sekilde asagi indirilir.
             Yayli dikey eklem: 0 = duz zeminde temas, + = iceri (yukari) cekilme -->
        <joint name="${position}_caster_joint" type="prismatic">
            <parent link="base_link"/>
            <child link="${position}_caster"/>
            <!-- caster_x_offset govde merkezine gore; govde merkezi base_link'te x=-wheel_x_offset -->
            <origin xyz="${-wheel_x_offset + reflect*caster_x_offset} 0 ${caster_radius - wheel_radius}" rpy="0 0 0"/>
            <axis xyz="0 0 1"/>
            <limit lower="${-caster_droop}" upper="${caster_travel}" effort="1000" velocity="5.0"/>
            <dynamics damping="${caster_damping}" friction="0.0"/>
        </joint>
        <gazebo reference="${position}_caster_joint">
            <springStiffness>${caster_spring_k}</springStiffness>
            <springReference>0.0</springReference>
            <implicitSpringDamper>true</implicitSpringDamper>
        </gazebo>
    </xacro:macro>

    <!-- Kamera diregi. Link orijini govde ust yuzeyinin merkezi (direkler bunun altina, govde
         tabanina kadar iner). vis=false: yalnizca collision (gorsel CAD mesh'inden) -->
    <xacro:macro name="mast_box" params="x y z sx sy sz vis:=true">
        <xacro:if value="${vis}">
            <visual>
                <origin xyz="${x} ${y} ${z}" rpy="0 0 0"/>
                <geometry><box size="${sx} ${sy} ${sz}"/></geometry>
                <material name="grey"/>
            </visual>
        </xacro:if>
        <collision>
            <origin xyz="${x} ${y} ${z}" rpy="0 0 0"/>
            <geometry><box size="${sx} ${sy} ${sz}"/></geometry>
        </collision>
    </xacro:macro>

    <xacro:macro name="camera_mast">
        <!-- z'ler link orijinine (govde ustu) gore -->
        <xacro:property name="pole_z" value="${mast_pole_len/2 - chassis_height}"/>
        <xacro:property name="bar_z"  value="${mast_bar_top - mast_profile/2 - chassis_height}"/>
        <xacro:property name="vis"    value="${not use_cad_visual}"/>
        <link name="camera_mast">
            <xacro:if value="${use_cad_visual}">
                <!-- Direkler + tepe profilleri + kelepceler + capraz baglanti -->
                <visual>
                    <origin xyz="0 0 0" rpy="0 0 0"/>
                    <geometry><mesh filename="${cad_mesh_dir}/mast.stl"/></geometry>
                    <material name="grey"/>
                </visual>
            </xacro:if>
            <!-- Direkler -->
            <xacro:mast_box x="${mast_pole_x}" y="0" z="${pole_z}" vis="${vis}"
                            sx="${mast_profile}" sy="${mast_profile}" sz="${mast_pole_len}"/>
            <xacro:mast_box x="${-mast_pole_x}" y="0" z="${pole_z}" vis="${vis}"
                            sx="${mast_profile}" sy="${mast_profile}" sz="${mast_pole_len}"/>
            <!-- Tepe profilleri: on-arka ve sol-sag -->
            <xacro:mast_box x="0" y="0" z="${bar_z}" vis="${vis}"
                            sx="${mast_bar_x_len}" sy="${mast_profile}" sz="${mast_profile}"/>
            <xacro:mast_box x="0" y="0" z="${bar_z}" vis="${vis}"
                            sx="${mast_profile}" sy="${mast_bar_y_len}" sz="${mast_profile}"/>
            <xacro:box_inertial mass="${mast_mass}" x="${mast_bar_x_len}" y="${mast_bar_y_len}"
                                z="${mast_bar_top}">
                <origin xyz="0 0 ${mast_bar_top/2 - chassis_height}" rpy="0 0 0"/>
            </xacro:box_inertial>
        </link>

        <joint name="camera_mast_joint" type="fixed">
            <parent link="chassis"/>
            <child link="camera_mast"/>
            <origin xyz="0 0 ${chassis_height}" rpy="0 0 0"/>
        </joint>
    </xacro:macro>

    <!-- name: front/rear/left/right, x/y: govde merkezine gore, yaw: bakis yonu
         Topic: /<name>_camera/image_raw, /<name>_camera/camera_info -->
    <xacro:macro name="camera" params="name x y yaw">
        <!-- <name>_camera_link: optik merkez, x ileri (Gazebo sensor bu linkte) -->
        <link name="${name}_camera_link">
            <visual>
                <xacro:if value="${use_cad_visual}">
                    <!-- Kamera + profile baglanan 43 deg mentese braketi; lens ucu optik merkezde -->
                    <origin xyz="0 0 0" rpy="0 0 0"/>
                    <geometry><mesh filename="${cad_mesh_dir}/camera.stl"/></geometry>
                </xacro:if>
                <xacro:unless value="${use_cad_visual}">
                    <origin xyz="${-camera_body_x/2} 0 0" rpy="0 0 0"/>
                    <geometry><box size="${camera_body_x} ${camera_body_y} ${camera_body_z}"/></geometry>
                </xacro:unless>
                <material name="black"/>
            </visual>
            <collision>
                <origin xyz="${-camera_body_x/2} 0 0" rpy="0 0 0"/>
                <geometry><box size="${camera_body_x} ${camera_body_y} ${camera_body_z}"/></geometry>
            </collision>
            <xacro:box_inertial mass="${camera_mass}" x="${camera_body_x}" y="${camera_body_y}" z="${camera_body_z}">
                <origin xyz="${-camera_body_x/2} 0 0" rpy="0 0 0"/>
            </xacro:box_inertial>
        </link>

        <joint name="${name}_camera_joint" type="fixed">
            <parent link="chassis"/>
            <child link="${name}_camera_link"/>
            <origin xyz="${x} ${y} ${camera_height - ground_clearance}"
                    rpy="${camera_roll} ${camera_pitch} ${yaw + camera_yaw}"/>
        </joint>

        <!-- ROS optik cerceve: z ileri, x saga, y asagi -->
        <link name="${name}_camera_optical_frame"/>
        <joint name="${name}_camera_optical_joint" type="fixed">
            <parent link="${name}_camera_link"/>
            <child link="${name}_camera_optical_frame"/>
            <origin xyz="0 0 0" rpy="${-PI/2} 0 ${-PI/2}"/>
        </joint>

        <gazebo reference="${name}_camera_link">
            <material>Gazebo/Black</material>
            <sensor type="camera" name="${name}_camera">
                <always_on>true</always_on>
                <update_rate>${camera_rate}</update_rate>
                <visualize>false</visualize>
                <camera>
                    <horizontal_fov>${camera_hfov}</horizontal_fov>
                    <image>
                        <width>${camera_img_w}</width>
                        <height>${camera_img_h}</height>
                        <format>R8G8B8</format>
                    </image>
                    <clip><near>0.05</near><far>50.0</far></clip>
                    <noise>
                        <type>gaussian</type>
                        <mean>0.0</mean>
                        <stddev>0.007</stddev>
                    </noise>
                </camera>
                <plugin name="${name}_camera_plugin" filename="libgazebo_ros_camera.so">
                    <ros><namespace>/</namespace></ros>
                    <camera_name>${name}_camera</camera_name>
                    <frame_name>${name}_camera_optical_frame</frame_name>
                </plugin>
            </sensor>
        </gazebo>
    </xacro:macro>

    <!-- Lidar govdesi (visual + collision + inertial). Govde tabani lidar_base_gap'te, link'e gore z -->
    <!-- geometry_block: <origin> + <geometry> (primitif; collision ve cad_visual=false gorseli) -->
    <xacro:macro name="lidar_body" params="mesh **geometry_block *inertial">
        <visual>
            <xacro:if value="${use_cad_visual}">
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry><mesh filename="${cad_mesh_dir}/${mesh}"/></geometry>
            </xacro:if>
            <xacro:unless value="${use_cad_visual}">
                <xacro:insert_block name="geometry_block"/>
            </xacro:unless>
            <material name="black"/>
        </visual>
        <collision>
            <xacro:insert_block name="geometry_block"/>
        </collision>
        <xacro:insert_block name="inertial"/>
    </xacro:macro>

    <!-- name: front/rear, x: govde merkezine gore, yaw: bakis yonu, topic: LaserScan topic'i,
         model: s3 / a2m8. Link orijini tarama merkezi, x ileri -->
    <xacro:macro name="lidar" params="name x yaw topic model">
        <xacro:property name="cz" value="${lidar_base_gap - lidar_scan_height}"/>  <!-- govde tabani, link'e gore -->
        <link name="${name}_lidar_link">
            <xacro:if value="${model == 's3'}">
                <xacro:lidar_body mesh="lidar_s3.stl">
                    <geometry_block>
                        <origin xyz="0 0 ${cz + lidar_s3_height/2}" rpy="0 0 0"/>
                        <geometry><box size="${lidar_s3_size_x} ${lidar_s3_size_y} ${lidar_s3_height}"/></geometry>
                    </geometry_block>
                    <xacro:box_inertial mass="${lidar_s3_mass}" x="${lidar_s3_size_x}" y="${lidar_s3_size_y}"
                                        z="${lidar_s3_height}">
                        <origin xyz="0 0 ${cz + lidar_s3_height/2}" rpy="0 0 0"/>
                    </xacro:box_inertial>
                </xacro:lidar_body>
            </xacro:if>
            <xacro:if value="${model == 'a2m8'}">
                <xacro:lidar_body mesh="lidar_a2m8.stl">
                    <geometry_block>
                        <origin xyz="0 0 ${cz + lidar_a2m8_height/2}" rpy="0 0 0"/>
                        <geometry><cylinder radius="${lidar_a2m8_radius}" length="${lidar_a2m8_height}"/></geometry>
                    </geometry_block>
                    <xacro:cylinder_inertial mass="${lidar_a2m8_mass}" radius="${lidar_a2m8_radius}"
                                             length="${lidar_a2m8_height}">
                        <origin xyz="0 0 ${cz + lidar_a2m8_height/2}" rpy="0 0 0"/>
                    </xacro:cylinder_inertial>
                </xacro:lidar_body>
            </xacro:if>
        </link>

        <joint name="${name}_lidar_joint" type="fixed">
            <parent link="chassis"/>
            <child link="${name}_lidar_link"/>
            <origin xyz="${x} 0 ${chassis_height + lidar_scan_height}" rpy="0 0 ${yaw}"/>
        </joint>

        <gazebo reference="${name}_lidar_link">
            <material>Gazebo/Black</material>
            <sensor type="ray" name="${name}_lidar">
                <always_on>true</always_on>
                <update_rate>${lidar_rate}</update_rate>
                <!-- Gazebo arayuzunde isin cizimi kapali (gzclient'i yorar). RViz /lidar_map etkilenmez -->
                <visualize>false</visualize>
                <ray>
                    <scan>
                        <horizontal>
                            <samples>${lidar_samples}</samples>
                            <resolution>1</resolution>
                            <min_angle>${-lidar_fov/2}</min_angle>
                            <max_angle>${lidar_fov/2}</max_angle>
                        </horizontal>
                    </scan>
                    <range>
                        <min>${lidar_min_range}</min>
                        <max>${lidar_max_range}</max>
                        <resolution>0.01</resolution>
                    </range>
                    <noise>
                        <type>gaussian</type>
                        <mean>0.0</mean>
                        <stddev>0.01</stddev>
                    </noise>
                </ray>
                <plugin name="${name}_lidar_plugin" filename="libgazebo_ros_ray_sensor.so">
                    <ros>
                        <namespace>/</namespace>
                        <remapping>~/out:=${topic}</remapping>
                    </ros>
                    <output_type>sensor_msgs/LaserScan</output_type>
                    <frame_name>${name}_lidar_link</frame_name>
                </plugin>
            </sensor>
        </gazebo>
    </xacro:macro>


    <!-- IMU: imu_link (x ileri, y sol, z yukari). Topic: /imu/data (sensor_msgs/Imu).
         Yon dunyaya gore MUTLAK (initial_orientation_as_reference=false): BNO085'in mutlak yaw'i gibi -->
    <xacro:macro name="imu_noise" params="std bias">
        <noise type="gaussian">
            <mean>0.0</mean><stddev>${std}</stddev>
            <bias_mean>0.0</bias_mean><bias_stddev>${bias}</bias_stddev>
        </noise>
    </xacro:macro>

    <xacro:macro name="imu">
        <link name="imu_link">
            <visual>
                <geometry><box size="0.03 0.03 0.01"/></geometry>
                <material name="black"/>
            </visual>
            <xacro:box_inertial mass="0.01" x="0.03" y="0.03" z="0.01">
                <origin xyz="0 0 0" rpy="0 0 0"/>
            </xacro:box_inertial>
        </link>
        <joint name="imu_joint" type="fixed">
            <parent link="chassis"/>
            <child link="imu_link"/>
            <origin xyz="${imu_x_offset} ${imu_y_offset} ${imu_height - ground_clearance}" rpy="0 0 0"/>
        </joint>
        <gazebo reference="imu_link">
            <sensor name="imu_sensor" type="imu">
                <always_on>true</always_on>
                <update_rate>${imu_rate}</update_rate>
                <imu>
                    <angular_velocity>
                        <x><xacro:imu_noise std="${imu_gyro_std}" bias="${imu_gyro_bias}"/></x>
                        <y><xacro:imu_noise std="${imu_gyro_std}" bias="${imu_gyro_bias}"/></y>
                        <z><xacro:imu_noise std="${imu_gyro_std}" bias="${imu_gyro_bias}"/></z>
                    </angular_velocity>
                    <linear_acceleration>
                        <x><xacro:imu_noise std="${imu_accel_std}" bias="0.0"/></x>
                        <y><xacro:imu_noise std="${imu_accel_std}" bias="0.0"/></y>
                        <z><xacro:imu_noise std="${imu_accel_std}" bias="0.0"/></z>
                    </linear_acceleration>
                </imu>
                <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
                    <ros>
                        <namespace>/</namespace>
                        <remapping>~/out:=imu/data</remapping>
                    </ros>
                    <initial_orientation_as_reference>false</initial_orientation_as_reference>
                    <frame_name>imu_link</frame_name>
                </plugin>
            </sensor>
        </gazebo>
    </xacro:macro>

    <!-- GPS: gps_link (anten faz merkezi). Topic: /gps/fix (NavSatFix), /gps/vel.
         Dunya dosyasinda <spherical_coordinates> olmali (yoksa enlem/boylam uretilmez) -->
    <xacro:macro name="gps_noise" params="std">
        <noise type="gaussian"><mean>0.0</mean><stddev>${std}</stddev></noise>
    </xacro:macro>

    <xacro:macro name="gps">
        <link name="gps_link">
            <visual>
                <geometry>
                    <xacro:if value="${use_cad_visual}">
                        <mesh filename="${cad_mesh_dir}/gps.stl"/>
                    </xacro:if>
                    <xacro:unless value="${use_cad_visual}">
                        <box size="${gps_body} ${gps_body} ${gps_body/2}"/>
                    </xacro:unless>
                </geometry>
                <material name="grey"/>
            </visual>
            <xacro:box_inertial mass="0.05" x="${gps_body}" y="${gps_body}" z="${gps_body/2}">
                <origin xyz="0 0 0" rpy="0 0 0"/>
            </xacro:box_inertial>
        </link>
        <joint name="gps_joint" type="fixed">
            <parent link="chassis"/>
            <child link="gps_link"/>
            <origin xyz="${gps_x_offset} ${gps_y_offset} ${gps_height - ground_clearance}" rpy="0 0 0"/>
        </joint>
        <gazebo reference="gps_link">
            <sensor name="gps_sensor" type="gps">
                <always_on>true</always_on>
                <update_rate>${gps_rate}</update_rate>
                <gps>
                    <position_sensing>
                        <horizontal><xacro:gps_noise std="${gps_h_std}"/></horizontal>
                        <vertical><xacro:gps_noise std="${gps_v_std}"/></vertical>
                    </position_sensing>
                    <velocity_sensing>
                        <horizontal><xacro:gps_noise std="${gps_vel_std}"/></horizontal>
                        <vertical><xacro:gps_noise std="${gps_vel_std}"/></vertical>
                    </velocity_sensing>
                </gps>
                <plugin name="gps_plugin" filename="libgazebo_ros_gps_sensor.so">
                    <ros>
                        <namespace>/</namespace>
                        <remapping>~/out:=gps/fix</remapping>
                        <remapping>~/vel:=gps/vel</remapping>
                    </ros>
                    <frame_name>gps_link</frame_name>
                </plugin>
            </sensor>
        </gazebo>
    </xacro:macro>

</robot>
