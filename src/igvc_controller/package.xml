<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>igvc_controller</name>
  <version>0.1.0</version>
  <description>RAKE IGVC skid steer kontrolcusu (cmd_vel -> tekerlek, enkoder -> odom) ve klavye surusu.</description>
  <maintainer email="todo@todo.com">todo</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>xacro</exec_depend>
  <!-- Simulasyon: Gazebo + ros2_control (gazebo.launch.py), tekerlek olculeri igvc_macros.xacro'dan -->
  <exec_depend>igvc_description</exec_depend>
  <!-- sim.launch.py ekf:=true -->
  <exec_depend>igvc_localization</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
