<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>igvc_nav</name>
  <version>0.1.0</version>
  <description>RAKE IGVC navigasyon: fused_map uzerinde yerel yol planlama (path_planner) ve takip (path_tracker).</description>
  <maintainer email="mmkuru8705@gmail.com">kury22</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <!-- /fused_map ve arac geometrisi (launch: igvc_vision.robot_geometry) -->
  <exec_depend>igvc_vision</exec_depend>
  <!-- navigation.launch.py (Nav2, entegre degil) nav2_bringup ister. -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
