<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>igvc_vision</name>
  <version>0.1.0</version>
  <description>RAKE IGVC algilama: anlik lidar yerel haritasi, 4 kameralı surround-view (kus bakisi) ve YOLO segmentasyon.</description>
  <maintainer email="todo@todo.com">todo</maintainer>
  <maintainer email="mmkuru8705@gmail.com">Muharrem KURU</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <!-- Arac olculeri launch'ta igvc_macros.xacro'dan okunur -->
  <exec_depend>igvc_description</exec_depend>
  <!-- Kamera topic'leri .../image_raw/compressed: Gazebo kamera eklentisi icin gerekli -->
  <exec_depend>compressed_image_transport</exec_depend>
  <!-- four_cam_test YOLO icin torch + ultralytics (pip) ister; yoksa yalnizca BEV calisir -->

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
